// =============================================================================
// NAHUAT PLATFORM — PRISMA SCHEMA
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// AUTH & USERS
// =============================================================================

model User {
  id       String   @id @default(cuid())
  // WHO VOUCHED FOR THIS PERSON, and the identifier they used. Replaced
  // `auth0Id` when authentication moved in-house (docs/adr/0018).
  //
  // TWO COLUMNS RATHER THAN ONE NAMED AFTER THE PROVIDER. A single `googleId`
  // would be a schema that has to be migrated to state something it could have
  // stated from the start, and it is already inaccurate: the seeded
  // development users are not Google subjects. Adding a provider later needs a
  // value in the enum and a verifier — no migration, and nothing in the token
  // path changes.
  //
  // ⚠️ STILL ONE IDENTITY PER PERSON, and that is the real limit — not the
  // naming. Two providers for one human cannot be expressed here, so account
  // LINKING would need an `identities` table keyed the way this pair is, with
  // a userId. That is deliberately not built: linking means deciding that a
  // matching email proves the same person, which is an account-takeover
  // question rather than a schema one, and the current answer is to refuse
  // (see EMAIL_ALREADY_REGISTERED).
  provider Provider
  subject  String

  // Set once, at account creation, and never re-synced. It is the unique key,
  // so following a change at the identity provider could collide with another
  // row — and the collision would surface as a failed login for someone who
  // changed nothing.
  email String @unique

  // Re-synced from Auth0 on every login by POST /auth/session. Not
  // user-editable. For connections that supply no name — email OTP — the email
  // stands in.
  name     String
  role     Role    @default(USER)
  isActive Boolean @default(true) @map("is_active")

  // Set by POST /auth/session, which the web callback invokes once per login.
  // Null only for rows created by the seed, which never log in.
  //
  // This is the only record that a login happened: the API sees requests, not
  // logins, so nothing else can distinguish an active account from a dormant
  // one. It is why account creation is an explicit step at the callback rather
  // than a side effect of the first authenticated request.
  lastLoginAt DateTime? @map("last_login_at")

  // User-chosen handle — auto-generated on first login (e.g. "victor_x7k2")
  // Editable once per 30 days. URL-safe: lowercase, numbers, underscores only.
  username          String?   @unique
  usernameUpdatedAt DateTime? @map("username_updated_at")

  // Profile photo, re-synced from Auth0 on every login by POST /auth/session.
  // Optional because not every connection returns one.
  pictureUrl String? @map("picture_url")

  // Learning language — which locale content is served in. Beats
  // Accept-Language during resolution: a Salvadoran-American may well have an
  // English browser and want Spanish. See ADR 15.
  locale Locale @default(ES)

  // Gamification
  // streak and lastActiveAt are denormalized caches — updated when
  // UserActivity is logged. Avoids recalculating streak on every request.
  xp           Int       @default(0)
  streak       Int       @default(0)
  lastActiveAt DateTime? @map("last_active_at")

  // Soft delete — deactivates account without breaking relation history.
  // Content attribution (createdEntries, updatedEntries etc) is preserved.
  // Auth0 session revoked via Management API on soft delete.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  flashcardSets    FlashcardSet[]
  userCardProgress UserCardProgress[]
  userActivity     UserActivity[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  // Attribution
  createdEntries      Entry[]       @relation("EntryCreator")
  updatedEntries      Entry[]       @relation("EntryUpdater")
  createdTranslations Translation[] @relation("TranslationCreator")
  updatedTranslations Translation[] @relation("TranslationUpdater")
  uploadedMedia       MediaAsset[]  @relation("MediaUploader")
  publishedMedia      MediaAsset[]  @relation("MediaPublisher")

  // The identity, and the reason `subject` carries no unique constraint of its
  // own: two providers may legitimately issue the same string, and only the
  // pair is guaranteed distinct.
  @@unique([provider, subject])
  @@map("users")
}

// Who authenticated a user. SEED exists because the development seed writes
// rows that never sign in — they hold authored content so that a fresh
// database has something to show, and giving them a real provider's name would
// be a lie the schema tells about where they came from.
//
// IMPORT is the same idea for a different writer: prisma/import.ts restores a
// dictionary export, whose attribution is flattened by design, and the restored
// rows need an author to point at. It is deliberately NOT SEED — unlike the
// seeder, an import runs in production, and a SEED row appearing there would
// read as "the development seed ran against production", which is precisely the
// misreading the paragraph above exists to prevent.
enum Provider {
  GOOGLE
  SEED
  IMPORT
}

// A refresh token, hashed. One row per token; one FAMILY per login session.
//
// WHY THIS TABLE EXISTS AT ALL, since identity is already resolved from the
// database on every authenticated request: that revokes an ACCOUNT, and cannot
// revoke a SESSION. "Sign out my other devices", or ending one stolen session
// without disabling the person entirely, has no expression without a record of
// which sessions exist. See docs/adr/0018.
model RefreshToken {
  id String @id @default(cuid())

  // THE SESSION. Every token rotated out of one login shares this, so
  // revocation — whether deliberate or triggered by reuse detection — acts on
  // the family rather than on a single token, which by then is already spent.
  familyId String @map("family_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the token, never the token. Not bcrypt or argon2, and the
  // reason is not only cost: those are deliberately slow to make guessing a
  // human-chosen password expensive, and this value is 32 bytes of CSPRNG
  // output with nothing to guess. A salted hash is also unsearchable — the
  // refresh path would have to scan every row and compare one by one, where a
  // deterministic digest is a unique-index seek.
  tokenHash String @unique @map("token_hash")

  // ABSOLUTE expiry, carried unchanged through every rotation because it
  // belongs to the family rather than to this row. Reset on each refresh, a
  // session refreshed hourly would never end and the cap would mean nothing.
  familyExpiresAt DateTime @map("family_expires_at")

  // IDLE expiry, belonging to this row: the deadline for using THIS token
  // before the session is treated as abandoned.
  idleExpiresAt DateTime @map("idle_expires_at")

  // Set when the token is spent, by a conditional update predicated on it
  // still being null. That condition is what makes rotation single-use under
  // concurrency — two simultaneous refreshes would otherwise both observe null
  // and both succeed, which is not merely a double issue but a hole in the
  // reuse detection below.
  usedAt DateTime? @map("used_at")

  // Set when the family is revoked: logout, or a spent token presented a
  // second time.
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Reuse detection and logout both act on the whole family, so this index
  // serves the only write that matters on the refresh path.
  @@index([familyId])
  // "Sign out everywhere", and the cleanup of a deactivated account's
  // sessions.
  @@index([userId])
  @@map("refresh_tokens")
}

// Locales content can be served in. Uppercase to match every other enum here;
// the wire format is lowercase ("?locale=es") and the column suffix is
// capitalized (contentEs) — see LOCALE_FIELD_SUFFIX in packages/shared.
//
// Nawat is deliberately absent. It is the subject being taught, shown to every
// learner regardless of language, and never a value selected between.
enum Locale {
  ES
  EN
}

enum Role {
  USER // learner — default role on signup, sees published content only
  CONTRIBUTOR // read drafts, create and edit all content (dictionary entries
  //   + lesson structure). Cannot publish — only ADMIN can publish.
  ADMIN // full access — publishing, user management, destructive ops
}

// =============================================================================
// DICTIONARY
// =============================================================================

model Entry {
  id           String    @id @default(cuid())
  type         EntryType @default(WORD)
  nawatContent String    @unique @map("nawat_content")
  // Canonical public URL identifier, derived from nawatContent by slugifyNawat
  // (@nahuat/shared) on write. @unique so two distinct headwords that fold to
  // the same slug fail loudly (ENTRY_SLUG_CONFLICT) instead of colliding
  // silently. See docs/adr/0016-dictionary-entry-slugs.
  slug         String    @unique
  // WRITTEN ONLY WHEN AN ADMIN PUBLISHES THE ASSET (docs/adr/0020). A populated
  // URL therefore asserts three things at once: processed, verified
  // retrievable, and approved. Presign does not write it, the upload does not,
  // and the processor does not. That is what keeps the public read a single
  // query that cannot leak — it joins nothing, so unprocessed, failed and
  // unreviewed media are unreachable by construction rather than by a filter
  // every future query has to remember. Unpublishing clears it.
  imageUrl     String?   @map("image_url")

  // The rendition ladder behind `imageUrl`, as [{width, height, url}] narrowest
  // first. WRITTEN AND CLEARED IN THE SAME TRANSACTION AS `imageUrl`, by the
  // same gate and nothing else, so the assertion above covers both.
  //
  // DENORMALISED ON PURPOSE. The set also lives on MediaAsset.derivatives, and
  // reading it from there would mean joining the public path to a row whose
  // derivatives are populated at READY — before approval — so the join would
  // have to re-check isPublished and rebuild the three-way assertion this
  // column exists to collapse. Copying it here at approval keeps the public
  // read a single query with no join.
  //
  // Json rather than a child table, for the reason MediaAsset.derivatives is:
  // nothing queries inside it, the shape follows the pipeline, and a table
  // would buy queryability no caller wants at the price of a migration per
  // width.
  //
  // Null on entries approved before this column existed, and on any asset whose
  // renditions lack a height. A reader with no ladder falls back to `imageUrl`.
  imageRenditions Json? @map("image_renditions")

  // The FK lives here rather than on MediaAsset, so an asset may exist before
  // it finds an entry (uploads are not attached at creation) and the public
  // read needs no join. @unique: one asset serves at most one entry.
  //
  // Restrict, not SetNull: detaching is what DELETE /entries/:id/image is for,
  // and letting a row deletion do it silently would route around the
  // sub-resource model. It also matches every other content FK here.
  imageAssetId String?     @unique @map("image_asset_id")
  imageAsset   MediaAsset? @relation("EntryImage", fields: [imageAssetId], references: [id], onDelete: Restrict)

  // Draft by default — only ADMIN can publish.
  // Unpublished and soft-deleted rows are hidden by an explicit
  // `where: { isPublished: true, deletedAt: null }` in the read services, not a
  // global Prisma filter: publish visibility is role-conditional, which a
  // client-wide extension cannot express cleanly. The public reads are @Public
  // and have no req.user to condition on, so they are unconditionally
  // published-only; drafts are reachable through the CONTRIBUTOR+ admin read
  // surface (GET /admin/entries), which applies its own scoping.
  // Hard delete allowed for unpublished entries (no preservation value).
  // Soft delete applied to published entries.
  isPublished Boolean   @default(false) @map("is_published")
  deletedAt   DateTime? @map("deleted_at")

  // Attribution
  creatorId String @map("creator_id")
  creator   User   @relation("EntryCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  updaterId String @map("updater_id")
  updater   User   @relation("EntryUpdater", fields: [updaterId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations Translation[]

  // Trigram search index NOT declared here. GET /entries/search matches on
  // immutable_unaccent(nawat_content), so it is accent-insensitive ("takat"
  // finds "tàkat"), and Prisma cannot model a functional index expression.
  // The GIN trigram index therefore lives in
  // 20260820163000_accent_insensitive_trigram_search, not here — which also
  // dropped the raw-column index this replaced (entries_nawat_content_trgm_idx),
  // since search was its only caller and now wraps the column in unaccent.
  //
  // NOT THE FULL INDEX SET. Two partial indexes are invisible here, because
  // Prisma cannot express a WHERE clause: entries_live_idx
  // (20260815160500_partial_live_indexes) covers the published public reads,
  // and entries_drafts_idx (20260824190000_admin_draft_index) covers the
  // admin draft queue. Check both before adding an index on
  // (isPublished, deletedAt) — between them they already cover it.
  @@map("entries")
}

// WORD and EXPRESSION are dictionary headwords — a single word vs. a multi-word
// lexical unit (idiom, fixed/common expression, collocation). PHRASE is a full
// teaching utterance that lives in lessons, not the dictionary browse; the
// public dictionary reads restrict to WORD/EXPRESSION.
enum EntryType {
  WORD
  EXPRESSION
  PHRASE
}

model Dialect {
  id            String @id @default(cuid())
  code          String @unique // lowercase slug, e.g. "common" or a town like "izalco" — see seed-data/dialects.ts
  // Required in both languages, unlike every other localized model. Dialects
  // are reference data authored by the project rather than contributed
  // content, so the "English required to publish, not to create" rule in
  // ADR 15 has nothing to protect here — there is no contributor to unblock.
  nameEs        String @unique @map("name_es") // e.g. "Nawat común", "Nawat de Izalco"
  nameEn        String @unique @map("name_en") // e.g. "Common Nawat", "Izalco Nawat"
  descriptionEs String @map("description_es")
  descriptionEn String @map("description_en")

  // Display order across dialects, lower first. `common` is 0 so it leads;
  // towns follow in a chosen order. This is the whole ordering for an entry's
  // translations and the basis of its headword — a dialect has at most one
  // translation per entry (see Translation @@unique), so nothing orders within
  // a dialect. Not unique: a new dialect defaults to 100 (sorts last) until
  // placed, and ties break on code. Provisional values, re-decided at teardown
  // like the codes themselves.
  precedence Int @default(100)

  translations Translation[]

  @@map("dialects")
}

model Translation {
  id          String @id @default(cuid())
  entryId     String @map("entry_id")
  dialectCode String @map("dialect_code")

  contentEs    String        @map("content_es")
  contentEn    String?       @map("content_en")
  phonetic     String? // pronunciation guide — IPA
  partOfSpeech PartOfSpeech? @map("part_of_speech")

  exampleNawat String? @map("example_nawat")
  exampleEs    String? @map("example_es")
  exampleEn    String? @map("example_en")

  // Written only on ADMIN approval of the asset — see the note on Entry.imageUrl.
  audioUrl String? @map("audio_url")

  audioAssetId String?     @unique @map("audio_asset_id")
  audioAsset   MediaAsset? @relation("TranslationAudio", fields: [audioAssetId], references: [id], onDelete: Restrict)

  // Draft by default — only ADMIN can publish.
  // Hard delete allowed for unpublished translations.
  // Soft delete applied to published translations.
  isPublished Boolean   @default(false) @map("is_published")
  deletedAt   DateTime? @map("deleted_at")

  // Attribution
  creatorId String @map("creator_id")
  creator   User   @relation("TranslationCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  updaterId String @map("updater_id")
  updater   User   @relation("TranslationUpdater", fields: [updaterId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entry   Entry   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  dialect Dialect @relation(fields: [dialectCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  flashcards       Flashcard[]
  userCardProgress UserCardProgress[]

  // One translation per dialect per entry. A word with several senses is one
  // row with a pipe-separated gloss, not several rows (see CreateTranslation in
  // packages/shared). Dialect precedence orders an entry's translations; there
  // is nothing to order within a dialect.
  @@unique([entryId, dialectCode])
  @@index([dialectCode])
  // Trigram search indexes NOT declared here — see the note on Entry. Both
  // content columns are indexed as immutable_unaccent(col) gin_trgm_ops in
  // 20260820163000_accent_insensitive_trigram_search (functional expressions
  // Prisma cannot model). Separate per-language indexes, not one composite: a
  // search hits either language alone and the planner BitmapOrs the two. The
  // raw-column indexes they replaced were dropped in that same migration.
  //
  // See note on Entry: translations_live_idx is partial and lives in the
  // migration, not here.
  @@map("translations")
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PARTICLE
  PREPOSITION
  CONJUNCTION
  OTHER
}

// =============================================================================
// MEDIA
// =============================================================================

// Audio recordings and images as a TABLE rather than status columns beside a
// URL (docs/adr/0020). Three things ruled the smaller shape out: processing is
// asynchronous, so a URL written at upload time points at media that may never
// become ready; derivatives are plural; and retries need somewhere to keep
// state. Provenance had nowhere to live in a nullable string either, and for a
// language with roughly a hundred speakers, who recorded a word and when is
// much of what makes the recording worth keeping.
//
// PROCESSING STATE AND REVIEW STATE ARE SEPARATE, AND NEITHER IMPLIES THE
// OTHER. `status` belongs to the pipeline and moves without a person;
// `isPublished` belongs to an ADMIN. A recording may be READY and unapproved;
// it can never be approved while still PENDING.
model MediaAsset {
  // Appears in the public object key (`public/{id}/...`), so it becomes part of
  // a permanent CDN URL. cuid is non-sequential and encodes nothing about the
  // uploader, which is why the key is built from it rather than from the user
  // id and a timestamp.
  id   String    @id @default(cuid())
  // Selects the transformations, not a separate consumer — one pipeline
  // handles both kinds. Stored rather than derived from contentType, which is
  // a client's claim; this is the server's decision, and the attach endpoints
  // refuse a mismatch (a translation takes AUDIO, an entry IMAGE).
  kind MediaKind

  status MediaStatus @default(AWAITING_UPLOAD)

  // The original upload: `source/{id}/{name}`. CHOSEN BY THE SERVER AT PRESIGN,
  // which is what stops a client deciding where its bytes land, and non-null
  // from creation because the key is what gets signed — it exists before the
  // object does. Never rewritten, and never served: the source is kept
  // permanently because derivatives can be regenerated at a better bitrate or
  // in a new format and a recording of one of ~100 speakers cannot.
  sourceKey String @map("source_key")

  // Both are SIGNED INTO THE PRESIGNED PUT, so S3 itself rejects a body that
  // disagrees. Kept afterwards because the processor compares the declared type
  // against the bytes it actually finds, and a mismatch is a signal worth
  // recording rather than a discrepancy to quietly correct.
  contentType String @map("content_type")
  sizeBytes   Int    @map("size_bytes")

  // What the processor wrote: for audio the transcode plus duration and
  // measured loudness, for images a width-keyed set. Json rather than a child
  // table because the shape differs by kind and will change as the pipeline
  // does, and NOTHING QUERIES INSIDE IT — the public read path reads the URL on
  // the parent row and never looks here. A child table would buy queryability
  // no caller wants at the price of a migration per derivative width.
  derivatives Json?

  // Null unless FAILED. Carried on the row for the admin surface and for
  // judging whether a retry is worth attempting.
  error String?

  // On the row rather than read from the SQS receive count: this is what the
  // review queue and any alarm read, it outlives the message, and it is what
  // lets retries stop without a person inspecting a dead-letter queue.
  attempts Int @default(0)

  // Who supplied the file. Restrict matches Entry.creatorId — attribution must
  // not disappear with a user row.
  uploaderId String @map("uploader_id")
  uploader   User   @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  // ALL PROVENANCE THAT IS NOT THE UPLOADER: who is heard, when the recording
  // was actually made, the conditions, the equipment, the setting. ADR 20
  // specifies a structured speaker reference and a recorded-at column; this has
  // neither — see the implementation amendment on that record.
  //
  // One free-text column rather than some fields typed and the rest not. Most
  // speakers of a language with roughly a hundred left will never hold an
  // account, so a foreign key cannot represent them; and once the who and the
  // where are prose, typing the when alone buys a column nothing queries. The
  // cost is that provenance is read rather than sorted. Reversible cheaply: a
  // nullable recorded_at is an additive migration whenever a caller wants one.
  notes String?

  // Review state, ADMIN only, deliberately the same name and meaning as
  // Entry.isPublished — the codebase already means one thing by it. Approval is
  // what copies derivatives from the pending prefix to the public one and
  // writes the URL on the parent; the prefix move, not the flag, is what makes
  // unapproved media unreachable rather than merely unlinked.
  isPublished   Boolean   @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at")
  // Who approved. The gate IS the quality-control claim, and an unattributed
  // approval is not much of one.
  publishedById String?   @map("published_by_id")
  publishedBy   User?     @relation("MediaPublisher", fields: [publishedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // The owning row, whichever it is. Both null means the asset is uploaded but
  // not yet attached, which is a legitimate state: uploads are not attached at
  // creation, so one can outlive the intent that produced it.
  entry       Entry?       @relation("EntryImage")
  translation Translation? @relation("TranslationAudio")

  @@index([status])
  @@index([uploaderId])
  // NOT THE FULL INDEX SET. The review queue reads
  // `status = READY AND is_published = false`, which wants a partial index, and
  // Prisma cannot express a WHERE clause — so it lives in the migration
  // alongside entries_live_idx and entries_drafts_idx, not here.
  @@map("media_assets")
}

enum MediaKind {
  AUDIO
  IMAGE
}

// AWAITING_UPLOAD IS NOT IN ADR 20, which specifies PENDING -> READY | FAILED.
// It is added because the row is created at presign, before any bytes exist, so
// a single PENDING would mean both "the browser has not uploaded yet" and
// "uploaded, waiting on the processor". ADR 20 makes an asset stuck in PENDING
// a MONITORED condition — the signal that a queue or a consumer is broken — and
// abandoned uploads are common enough to drown that signal from the first day.
// Splitting them keeps PENDING meaning exactly "queued and unprocessed", and
// hands a future reaper the precise set of objects that were never claimed.
enum MediaStatus {
  AWAITING_UPLOAD
  PENDING
  READY
  FAILED
}

// =============================================================================
// FLASHCARDS
// =============================================================================

model FlashcardSet {
  id            String  @id @default(cuid())
  userId        String  @map("user_id")
  // Both nullable, and exactly one rule does not apply to both kinds of set.
  //
  // A private set is named once by its author, in their own language: asking a
  // learner to name their own study deck twice is friction with no payoff, and
  // there is nobody else to fill the gap. An official set is project content
  // and needs both, enforced on the isOfficial toggle rather than here.
  //
  // "At least one name" is a CHECK constraint in the migration — Prisma cannot
  // express one. "Both when official" is deliberately NOT a constraint: it is
  // a product rule, and it belongs with the other _NOT_PUBLISHABLE guards.
  nameEs        String? @map("name_es")
  nameEn        String? @map("name_en")
  descriptionEs String? @map("description_es")
  descriptionEn String? @map("description_en")

  // isOfficial — admin/contributor created, surfaced as curated sets
  // isFeatured — pinned to top of explore page by admin
  isOfficial Boolean @default(false) @map("is_official")
  isFeatured Boolean @default(false) @map("is_featured")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@index([userId, updatedAt])
  @@index([isOfficial, isFeatured, updatedAt])
  @@map("flashcard_sets")
}

model Flashcard {
  id            String @id @default(cuid())
  setId         String @map("set_id")
  translationId String @map("translation_id")

  set         FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  translation Translation  @relation(fields: [translationId], references: [id], onDelete: Restrict)

  @@unique([setId, translationId])
  @@map("flashcards")
}

// SRS progress is global per user per translation — not per set.
// Reviewing a word in any set advances the same schedule.
// Seeded automatically when a lesson is completed (via LessonVocabulary).
model UserCardProgress {
  id            String @id @default(cuid())
  userId        String @map("user_id")
  translationId String @map("translation_id")

  // ts-fsrs algorithm fields
  due           DateTime
  stability     Float
  difficulty    Float
  elapsedDays   Int       @default(0) @map("elapsed_days")
  scheduledDays Int       @default(0) @map("scheduled_days")
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         CardState @default(NEW)
  lastReview    DateTime? @map("last_review")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation Translation @relation(fields: [translationId], references: [id], onDelete: Restrict)

  @@unique([userId, translationId])
  @@index([userId, due]) // critical — SRS queue: fetch due cards for a user
  @@index([translationId])
  @@map("user_card_progress")
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

// =============================================================================
// LESSONS
// =============================================================================

// =============================================================================
// PROGRESS TRACKING
// =============================================================================

// Unified activity event log — source of truth for streak calculation
// and usage analytics.
//
// Streak calculation:
//   lastActiveAt = yesterday → increment streak
//   lastActiveAt = today     → already updated, no change
//   lastActiveAt = older     → reset streak to 1
//   streak on User is a denormalized cache — avoids recalculating on every request.
//
// Analytics enabled by full DateTime (not date-only):
//   Session duration: MAX(date) - MIN(date) within a session
//   Peak usage hours: hour distribution across activity rows
//   Time between activities, events per session
//
// metadata stores event-specific context:
//   REVIEW_SESSION: { cardsReviewed, cardsCorrect, durationSeconds? }
model UserActivity {
  id       String       @id @default(cuid())
  userId   String       @map("user_id")
  type     ActivityType
  date     DateTime     @default(now()) // full timestamp — enables session analytics
  metadata Json? // event-specific context (see comment above)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("user_activity")
}

// What a recorded activity was. LESSON_COMPLETED was removed with the learning
// hierarchy (ADR 22) — there are no lessons to complete, and the consumer that
// would have reacted to one is re-scoped to review sessions by that same ADR.
// Add members back when there are events to name.
enum ActivityType {
  REVIEW_SESSION
}

// =============================================================================
// AUDIT
// =============================================================================

// Full audit trail of all content changes.
// userId is nullable — set to null (SetNull) if the acting user is hard deleted.
// Soft deleted users retain their userId reference — logs remain fully attributed.
// changes stores a before/after diff of modified fields as { before: {}, after: {} }.
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType EntityType  @map("entity_type")
  entityId   String      @map("entity_id")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  changes Json?

  // DEAD, and deliberately still here. The column carried idempotency for an
  // asynchronous audit consumer; ADR 19 deleted that consumer and made audit
  // writes synchronous, in the transaction as the change they describe, so
  // nothing populates this and every row is null. It is dropped in the same
  // migration that implements the audit write path — separating the two would
  // mean two migrations to reach the same schema.
  sqsMessageId String? @unique @map("sqs_message_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum EntityType {
  ENTRY
  TRANSLATION
  DIALECT
  FLASHCARD_SET
  FLASHCARD
  LEVEL
  COURSE
  UNIT
  LESSON
  EXERCISE
  USER
  MEDIA_ASSET
}

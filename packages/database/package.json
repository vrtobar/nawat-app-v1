{
  "name": "@nahuat/database",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev-users": {
      "types": "./dist/dev-users.d.ts",
      "default": "./dist/dev-users.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed.ts --dev",
    "db:export": "tsx prisma/export.ts",
    "db:import": "tsx prisma/import.ts",
    "db:server-address": "tsx prisma/server-address.ts",
    "db:psql": "docker compose exec postgres psql -U nahuat -d nahuat_dev",
    "db:studio": "prisma studio",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@nahuat/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}

# Dependencies
node_modules/

# Turborepo
.turbo/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Prisma generated client
packages/database/src/generated/

# Lambda build artifacts
*.zip

# Testing
coverage/

# Environment variables
# Everything, then the one exception. The enumerated form this replaces
# (.env, .env.local, .env.*.local) covered the names anyone thought of and
# missed the ones they did not: a backup written beside a real file —
# `cp .env.local .env.local.bak-$(date ...)` — matched none of them, so it
# showed as untracked rather than ignored, one `git add -A` from a public
# repository. Only .env.example files are tracked, so denying by default costs
# nothing and stops the next variant needing a new line here.
.env*
!.env.example

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
# Saved plans are build artifacts, never committed. Both patterns: a plan
# written as `-out=tfplan` has no extension and slips past *.tfplan.
*.tfplan
tfplan
# Terraform reads .terraform.lock.hcl from root modules only; copies inside
# child modules are artifacts of validating them standalone.
infra/terraform/modules/*/.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Misc caches
.eslintcache

# Signing key for the local mock OIDC issuer (apps/api/scripts/mock-oidc).
# Generated on first run of `npm run auth:mock`; delete it to rotate. A
# throwaway development key — it signs tokens only an API pointed at
# http://localhost will verify — but a private key all the same.
apps/api/.mock-oidc-key.json

# Python — the media consumer is the only Python in the repository, and none
# of the tooling that produces these is npm's, so nothing else would have
# caught them.
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Planning/handoff space 
.claude/
